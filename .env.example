# ============================================================
# 环境变量示例（NoneBot2 项目）
# 复制本文件为 .env.prod（或 .env.dev / .env）后按需修改
# 真实 .env 文件已被 .gitignore 忽略，不会提交到仓库
# ============================================================

# 驱动方式：FastAPI（HTTP + WebSocket），NoneBot2 默认驱动
DRIVER=~fastapi

# NoneBot 监听地址与端口（bilibili 插件的 Web 后台也使用该端口）
HOST=127.0.0.1
PORT=8080

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 命令前缀（JSON 数组），/退休、/help 等命令以这些符号开头
COMMAND_START=["/", "."]

# 超级用户 QQ 号列表（JSON 数组格式），拥有最高管理权限
SUPERUSERS=[""]

# localstore 插件的数据目录是否基于当前工作目录
# 设为 true 后插件数据（订阅、配置等）保存在项目根目录的 data/ 下
LOCALSTORE_USE_CWD=true

# 是否启用 bilibili 插件的 Web 管理后台
# 启用后可通过 http://127.0.0.1:8080/bili-subscription/ 访问
BILI_SUBSCRIPTION_WEB_ENABLED=true

# ---- 以下为可选配置，按需取消注释 ----

# bilibili 插件的数据目录（订阅列表、登录 Cookie 等）
# 不设置则使用插件默认目录；已运行过的项目请保持默认，避免数据目录变更
# BILI_DATA=./data/nonebot_plugin_bilibili

# ---- 自动批准（好友申请 / 群邀请，默认关闭）----

# 自动同意好友申请
# AUTO_APPROVE_FRIEND=true

# 自动同意群邀请
# AUTO_APPROVE_GROUP_INVITE=true

# 同意后私聊通知超级用户
# AUTO_APPROVE_NOTIFY_SUPERUSER=true

# ---- jmdownloader 插件（JMComic 搜索/下载，全部可选）----

# JM 登录用户名/密码（不登录时部分本子会受限）
# JMCOMIC_USERNAME=
# JMCOMIC_PASSWORD=

# 网络代理地址，默认 system（更多格式见 jmcomic 文档）
# JMCOMIC_PROXIES=127.0.0.1:10809

# 是否开启 JMComic 日志输出
# JMCOMIC_LOG=false

# 下载线程数量（范围 1~50，默认 10）
# JMCOMIC_THREAD_COUNT=10

# 群列表模式：blacklist（默认禁用所有群）/ whitelist（默认启用所有群）
# JMCOMIC_GROUP_LIST_MODE=blacklist

# 是否允许私聊使用功能（默认 true）
# JMCOMIC_ALLOW_PRIVATE=true

# 每位用户每周下载限制次数（默认 5）
# JMCOMIC_USER_LIMITS=5

# 输出格式：pdf 或 zip（默认 pdf）
# JMCOMIC_OUTPUT_FORMAT=pdf

# ZIP/PDF 密码模板，{id} 会被替换为 jm 号，留空不加密
# JMCOMIC_ZIP_PASSWORD=
# JMCOMIC_PDF_PASSWORD=

# 是否修改 PDF 的 MD5 以避免发送失败（仅 pdf 有效）
# JMCOMIC_MODIFY_REAL_MD5=false

# 每页显示的搜索结果数量（默认 20，建议 40 以内）
# JMCOMIC_RESULTS_PER_PAGE=20

# 单次下载最大页数限制，0 表示不限制（默认 150）
# JMCOMIC_MAX_PAGE_COUNT=150

# 是否允许本子集（多章节）下载功能（默认关闭，每次消耗 1 次下载额度）
# JMCOMIC_ALLOW_ALBUM_DOWNLOAD=false

# 群员下载违规内容时是否惩罚（禁言+拉黑，默认 true）
# JMCOMIC_PUNISH_ON_VIOLATION=true
